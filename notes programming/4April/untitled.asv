%% Example 2
% clear 
% clc
% global counter
% counter=0;
% increment();
% decrement();
% 
% disp(counter)
% 
% function increment()
% global counter
% counter=counter+1;
% end
% 
% function decrement()
% global counter
% counter=counter-1;
% end

%% Example 3

% kind of nested loop
% 
% clear
% clc
% 
% global total
% total=0;
% for i=1:5
%     addToTotal(i);
% end
% disp(total)
% 
% function addToTotal(n)
% global total
% total=total+n;
% end

%% Example 4
% global a b
% a=3;
% b=4;
% compute();
% disp(a)
% disp(b)
% function compute()
% global a b 
% a=a+b;
% b=a*b;
% end


