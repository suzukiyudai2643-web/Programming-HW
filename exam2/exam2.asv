%% Q1
clear
clc
t=0:.05:10;
y1=(sin(t)).*exp(-2.*t);
y2=cos(t).*exp(-0.5.*t);
plot(t,y1,"*")
hold on
plot(t,y2,"o")
title('y(t)=sin(t)e^{2t} vs y(t)=cos(t)e^{-0.5t}')
xlabel('t values')
ylabel('y(t)')
legend('sin(t)e^{-2t}','cos(t)e^{-0.5t}')
