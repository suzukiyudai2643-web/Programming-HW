%% Q3
clear 
clc
g=@(x) cos(x);

p0=0;
TOL=10^(-5);
N0=100;
i=1;
while i<=N0
    p=g(p0);
    plot(i,p,'.')
    hold on
   
    if abs(p-p0)<TOL
        fprintf('the procedure was successful: root is:%f \n',p)
        break
    end
    i=i+1;
    p0=p;
    if i==N0
        fprintf('the method failed after %d interations, the procedure was unsuccessful.\n ',i)
    end

end
title('the approximation of the root')
xlabel('the number of interation')
ylabel('the approximated value')

% the procedure was successful: root is:0.739082 



%% Q4
clear 
clc
n=1;
p=0;
x=1.5;
while true
    p=0;
    
    for i=1:n
    p=p+(-1)^(i+1)/i*(x-1)^i;
    subplot()
    end
    if abs(0.40546511-p)<10^(-5)
    fprintf('the approximation needed %d terms and was: %f\n',n,p)
    break
    end

n=n+1;
end

% the approximation needed 12 terms and was: 0.405459
