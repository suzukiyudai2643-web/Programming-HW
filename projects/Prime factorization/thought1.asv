%% primary thought
squarenumbers=(1:2:1001).^2;
disp(squarenumbers)
%%
c=ipnut('enter a natural nubmer: ');
factor=1;
while c>1
    if mod(c,2)==0
        c=c/2;
        factor=factor*2;
        fprintf('%d',factor)
        continue
    end
    k=floor(c/3);
    for a=1:k
        B=c-a^2;
        exists=any(squarenumbers==B);
        if exists==1
            b=find(squarenumbers==B);
            fprintf('%d,%d',a+b,a-b)
        elseif exists==0
            continue
        elseif 
        end
    

    
